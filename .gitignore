.vercel

# Local Netlify folder
.netlify

# Full-resolution originals. Only the optimised variants generated from these
# belong in the repo — a multi-megabyte original would be deployed otherwise.
images/source/*
!images/source/README.md

# Raw Meshy exports stay local — only the optimised .glb is committed.
models/source/*
!models/source/README.md

# never the raw project files
*.blend
*.fbx
*.obj
