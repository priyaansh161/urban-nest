.vercel

# Local Netlify folder
.netlify

# Full-resolution originals and photograph candidates. Only the cropped WebP
# files sitting directly in images/ ship; every subfolder is working material.
# 82 candidates arrived as 244 MB of JPG, and Netlify deploys whatever it is
# not told to ignore, so this keeps them out of both the repo and the site.
images/*/
!images/source/
images/source/*
!images/source/README.md

# Raw Meshy exports stay local — only the optimised .glb is committed.
models/source/*
!models/source/README.md

# The deploy folder, assembled by tools/build-site.mjs. Generated, never edited.
dist/

# Local tooling. The scripts are committed, their dependencies are not —
# sharp alone is ~100 MB, and Netlify deploys whatever it is not told to ignore.
tools/node_modules/

# Screenshots from tools/regression.mjs. Retaken before every change, so
# there is nothing here worth keeping.
tools/regression/

# never the raw project files
*.blend
*.fbx
*.obj

# Secrets for local function testing. Real keys live here and never in the
# repo — the deployed site reads the same names from Netlify's env vars.
.env

# Local Cloudflare settings for `wrangler pages dev`. Placeholders only; never real keys.
.dev.vars
.wrangler/

# Instagram API credentials for tools/ig-insights.mjs. Real token, never committed.
tools/.ig-credentials.json

# scratch moved here 2026-11-08
_archive/

# 3D room working files (2026-11-14): bake intermediates, review renders, logs and backups stay local
*.blend1
*.log
__pycache__/
mocks/backups_*/
mocks/review_*/
mocks/*/renders/
mocks/*/*_raw.glb
mocks/*/products/*_raw.glb
mocks/*/products/*_look.png
mocks/room-living/living_v1*.glb
mocks/room-living/living_v1_*.blend
mocks/room-living/*_check.glb
mocks/room-living/bansuri_new.glb
mocks/room-living/kaniel_boucle*.glb
mocks/room-living/mk2-toilet-mat-flat*.glb
mocks/room-living/all*.json
mocks/room-living/saved_layout.json
mocks/room-living/source/
mocks/room-bedroom/source/nightstand/
mocks/room-pharmacy/*.glb
x.png
mocks/room-living/backup_live_v3/
