.vercel

# Local Netlify folder
.netlify

# Full-resolution originals and photograph candidates. Only the cropped WebP
# files sitting directly in images/ ship; every subfolder is working material.
# 82 candidates arrived as 244 MB of JPG, and Netlify deploys whatever it is
# not told to ignore, so this keeps them out of both the repo and the site.
images/*/
!images/source/
images/source/*
!images/source/README.md

# Raw Meshy exports stay local — only the optimised .glb is committed.
models/source/*
!models/source/README.md

# never the raw project files
*.blend
*.fbx
*.obj
