# Cloudflare Pages rules (the same as netlify.toml's redirects).
# The printed QR on the visiting cards encodes /hello. 302 on purpose, so its
# destination can change without reprinting cards.
/hello  /  302

# One page, designer.html, serves every designer's address. 200 = rewrite:
# the visitor keeps seeing /designers/<name>. The target has no .html:
# Cloudflare redirects /designer.html to /designer, which would lose the name.
/designers/*  /designer  200

# The first-generation Spline rooms were taken down on 25 Oct 2026; rooms return one at a time, rebuilt,
# under /rooms/. Old links (shared, bookmarked, in search) land on the rebuilt bath or on Spaces. 302, not
# 301: a rebuilt kitchen or bedroom may take these addresses back.
/bathroom       /rooms/quiet-bath/  302
/bathroom.html  /rooms/quiet-bath/  302
/kitchen        /spaces             302
/kitchen.html   /spaces             302
/bedroom        /rooms/sunday-bedroom/  302
/bedroom.html   /rooms/sunday-bedroom/  302

