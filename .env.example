# ═══════════════════════════════════════════════════════════════
#  URBAN NEST — SECRETS FOR THE CHECKOUT FUNCTIONS
#
#  Copy this file to ".env" in the same folder and fill in the real
#  values. ".env" is gitignored and never leaves your machine.
#
#      copy .env.example .env
#
#  The deployed site does not read this file — it reads the same four
#  names from Netlify, set under
#  Site configuration → Environment variables.
# ═══════════════════════════════════════════════════════════════


# ── RAZORPAY ───────────────────────────────────────────────────
#  Dashboard → Settings → API Keys, with the dashboard's top-left
#  toggle set to TEST MODE. Generate a key and you get both halves;
#  the secret is shown once, so save it now.
#
#  A test key id always starts rzp_test_. If you ever see rzp_live_
#  here, stop — that is real money.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

#  Set when you add the webhook (Dashboard → Settings → Webhooks).
#  Leave blank until then — the webhook simply refuses everything
#  while it is empty, which is the safe way round.
RAZORPAY_WEBHOOK_SECRET=


# ── SUPABASE ───────────────────────────────────────────────────
#  Dashboard → Project Settings → API Keys → "Secret keys" → the
#  sb_secret_... one. (Older projects call this the "service_role" key —
#  same thing, Supabase renamed it. NOT the publishable/anon key.)
#  Use the copy button rather than the reveal eye.
#
#  ┌───────────────────────────────────────────────────────────┐
#  │ This key bypasses row-level security completely. It must  │
#  │ NEVER appear in any page, any browser, or any commit — it │
#  │ belongs only in this file and in Netlify's env vars. The  │
#  │ anon key in supabase.js is the public one; this is not.   │
#  └───────────────────────────────────────────────────────────┘

SUPABASE_URL=https://ifwxgwvsyispkaxzbstg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
